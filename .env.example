# Serverless API (Vercel)
GEMINI_API_KEY=coloque_sua_chave_do_gemini_no_painel_da_vercel

# Demo/auth migration
# Use somente em desenvolvimento se precisar manter o fluxo legado enquanto
# migra usuarios para Firebase Auth.
VITE_ENABLE_DEMO_AUTH=false

# EmailJS configuration
VITE_EMAILJS_SERVICE_ID=service_3it9k2c
VITE_EMAILJS_TEMPLATE_ID=template_6m7nm4t
VITE_EMAILJS_PUBLIC_KEY=coloque_sua_chave_publica_emailjs_aqui

# Firebase Admin SDK (necessario para admin criar/excluir usuarios no Auth)
# Opcao 1: JSON completo da conta de servico em uma unica linha
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"senac-lanches","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# Opcao 2: campos separados
FIREBASE_PROJECT_ID=senac-lanches
FIREBASE_CLIENT_EMAIL=...
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n

# Notificacoes push (gerar com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=chave_publica_vapid
VAPID_PUBLIC_KEY=chave_publica_vapid
VAPID_PRIVATE_KEY=chave_privada_vapid
VAPID_SUBJECT=mailto:contato@senaclanches.com
