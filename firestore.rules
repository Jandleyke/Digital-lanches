rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && userDoc().data.ativo != false
        && (
          (userDoc().data.keys().hasAny(['roles']) && userDoc().data.roles is list && userDoc().data.roles.hasAny(roles)) ||
          (userDoc().data.keys().hasAny(['perfis']) && userDoc().data.perfis is list && userDoc().data.perfis.hasAny(roles)) ||
          (userDoc().data.keys().hasAny(['role']) && userDoc().data.role in roles) ||
          (userDoc().data.keys().hasAny(['perfil']) && userDoc().data.perfil in roles)
        );
    }

    function isStaff() {
      return hasRole(['admin', 'gerente', 'vendedora', 'vendedor', 'cozinha']);
    }

    function isCozinhaOuAdmin() {
      return hasRole(['admin', 'gerente', 'cozinha']);
    }

    function podeGerenciarAvisos() {
      return isStaff() || hasRole(['professor']);
    }

    function atualizacaoLeituraAviso() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidoPor', 'lidoDetalhes']);
    }

    function atualizacaoRespostaAviso() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas']);
    }

    function atualizacaoFixarAviso() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fixado', 'fixadoPorUsuarios', 'fixadoDetalhes']);
    }

    function atualizacaoArquivarAviso() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arquivadoPorUsuarios', 'arquivadoDetalhes']);
    }

    function atualizacaoLimparHistoricoAviso() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['historicoOcultoPorUsuarios']);
    }

    function isAvisoAutor() {
      return isSignedIn() && resource.data.autorId == request.auth.uid;
    }

    function atualizacaoPropriaSegura() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome',
        'curso',
        'telefone',
        'email',
        'fotoPerfil',
        'alergias'
      ]);
    }

    function decrementoEstoquePorPedido() {
      return hasRole(['aluno', 'professor'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque'])
        && request.resource.data.estoque is number
        && request.resource.data.estoque >= 0
        && request.resource.data.estoque < resource.data.estoque
        && (resource.data.estoque - request.resource.data.estoque) <= 20;
    }

    function devolucaoEstoquePorPedido() {
      return hasRole(['aluno', 'professor', 'vendedor', 'vendedora', 'admin', 'gerente'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque'])
        && request.resource.data.estoque is number
        && request.resource.data.estoque >= 0
        && request.resource.data.estoque > resource.data.estoque
        && (request.resource.data.estoque - resource.data.estoque) <= 20;
    }

    function quantidadesProdutoValidas() {
      return request.resource.data.estoque is number
        && request.resource.data.estoque >= 0
        && (!request.resource.data.keys().hasAny(['estoqueInicial'])
          || (request.resource.data.estoqueInicial is number && request.resource.data.estoqueInicial >= 0))
        && (!request.resource.data.keys().hasAny(['estoqueBaixo'])
          || (request.resource.data.estoqueBaixo is number && request.resource.data.estoqueBaixo >= 0));
    }

    function atualizacaoEstoqueBebidaVendedor() {
      return hasRole(['vendedor', 'vendedora'])
        && resource.data.categoria == 'Bebidas'
        && request.resource.data.categoria == 'Bebidas'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque'])
        && request.resource.data.estoque is number
        && request.resource.data.estoque >= 0;
    }

    function decrementoEstoquePedidoBalcao() {
      return hasRole(['vendedor', 'vendedora'])
        && resource.data.disponivel != false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque'])
        && request.resource.data.estoque is number
        && request.resource.data.estoque >= 0
        && request.resource.data.estoque < resource.data.estoque
        && (resource.data.estoque - request.resource.data.estoque) <= 20;
    }

    function atualizacaoProdutoAdminSemEstoque() {
      return hasRole(['admin', 'gerente'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estoque']);
    }

    function atualizacaoProdutoVendedorSemEstoque() {
      return hasRole(['vendedor', 'vendedora'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preco', 'estoque', 'categoria']);
    }

    function atualizacaoProdutoCozinha() {
      return hasRole(['cozinha'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preco'])
        && request.resource.data.estoque is number
        && request.resource.data.estoque >= 0;
    }

    function criacaoProdutoVendedorValida() {
      return hasRole(['vendedor', 'vendedora'])
        && request.resource.data.estoque is number
        && request.resource.data.estoque >= 0
        && (request.resource.data.categoria == 'Bebidas' || request.resource.data.estoque == 0);
    }

    function atualizacaoAjusteProducaoVendedor() {
      return hasRole(['vendedor', 'vendedora'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantidadePronta',
          'quantidadeRestante',
          'status',
          'observacao',
          'atualizadoPor',
          'atualizadoEm',
          'historico'
        ]);
    }

    function leituraProducaoCardapio() {
      return hasRole(['aluno', 'professor']);
    }

    function consumoProducaoPorPedido() {
      let vendidaAntes = resource.data.quantidadeVendida;
      let vendidaDepois = request.resource.data.quantidadeVendida;
      let restanteAntes = resource.data.quantidadeRestante;
      let restanteDepois = request.resource.data.quantidadeRestante;
      let quantidade = vendidaDepois - vendidaAntes;
      return hasRole(['aluno', 'professor'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantidadeVendida',
          'quantidadeRestante',
          'status',
          'atualizadoEm'
        ])
        && request.resource.data.quantidadeVendida is number
        && request.resource.data.quantidadeRestante is number
        && quantidade > 0
        && quantidade <= 20
        && restanteAntes >= quantidade
        && restanteDepois == restanteAntes - quantidade
        && vendidaDepois == vendidaAntes + quantidade
        && request.resource.data.quantidadeRestante >= 0
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status == resource.data.status
          || (request.resource.data.status == 'Esgotado' && request.resource.data.quantidadeRestante == 0)
        );
    }

    function devolucaoProducaoPorPedido() {
      let vendidaAntes = resource.data.quantidadeVendida;
      let vendidaDepois = request.resource.data.quantidadeVendida;
      let restanteAntes = resource.data.quantidadeRestante;
      let restanteDepois = request.resource.data.quantidadeRestante;
      let quantidade = vendidaAntes - vendidaDepois;
      return hasRole(['aluno', 'professor', 'vendedor', 'vendedora', 'admin', 'gerente'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantidadeVendida',
          'quantidadeRestante',
          'status',
          'atualizadoEm'
        ])
        && resource.data.quantidadeVendida is number
        && request.resource.data.quantidadeVendida is number
        && resource.data.quantidadeRestante is number
        && request.resource.data.quantidadeRestante is number
        && quantidade > 0
        && quantidade <= 20
        && vendidaDepois >= 0
        && vendidaDepois == vendidaAntes - quantidade
        && restanteDepois == restanteAntes + quantidade
        && request.resource.data.quantidadeRestante >= 0
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status == resource.data.status
          || (request.resource.data.status == 'Pronto para venda' && request.resource.data.quantidadeRestante > 0)
        );
    }

    function isPedidoOwner() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function isNovoPedidoOwner() {
      return isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid)
        && (!request.resource.data.keys().hasAny(['alunoId']) || request.resource.data.alunoId == request.auth.uid);
    }
    function formaPagamentoValida() {
      return request.resource.data.formaPagamento in [
        'Dinheiro',
        'PIX',
        'Pix',
        'Débito',
        'Crédito',
        'Debito',
        'Credito',
        'DÃ©bito',
        'CrÃ©dito',
        'Conta do Professor'
      ];
    }

    function usuarioPodeCriarPedidoApp() {
      return hasRole(['aluno', 'professor'])
        && isNovoPedidoOwner()
        && request.resource.data.status == 'Recebido'
        && request.resource.data.origem == 'app'
        && request.resource.data.aluno is string
        && request.resource.data.aluno.size() >= 2
        && request.resource.data.matricula is string
        && request.resource.data.alunoPerfil in ['aluno', 'professor']
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.horarioRetirada is string
        && request.resource.data.horarioRetiradaEm is number
        && request.resource.data.numero is int
        && request.resource.data.numero > 0
        && request.resource.data.numero <= 9999
        && formaPagamentoValida()
        && (
          request.resource.data.formaPagamento != 'Conta do Professor'
          || request.resource.data.alunoPerfil == 'professor'
        );
    }

    function isPedidoAvulsoDoNome() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && resource.data.alunoCadastrado == false
        && userDoc().data.nomeVinculo is string
        && (
          (
            'nomeVinculo' in resource.data
            && resource.data.nomeVinculo is string
            && resource.data.nomeVinculo == userDoc().data.nomeVinculo
          )
          || (
            resource.data.aluno == userDoc().data.nome
          )
        );
    }

    function vinculoPedidoAvulsoValido() {
      return isPedidoAvulsoDoNome()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'matricula',
          'nomeVinculo',
          'alunoCadastrado',
          'alunoPerfil',
          'vinculadoEm',
          'vinculadoPor'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matricula == userDoc().data.matricula
        && request.resource.data.nomeVinculo == userDoc().data.nomeVinculo
        && request.resource.data.alunoCadastrado == true
        && request.resource.data.vinculadoPor == request.auth.uid;
    }

    function contaProfessorPedidoBalcaoValida() {
      return request.resource.data.formaPagamento != 'Conta do Professor'
        || (
          request.resource.data.alunoCadastrado == true
          && exists(/databases/$(database)/documents/usuarios/$(request.resource.data.uid))
          && (
            get(/databases/$(database)/documents/usuarios/$(request.resource.data.uid)).data.role == 'professor'
            || get(/databases/$(database)/documents/usuarios/$(request.resource.data.uid)).data.perfil == 'professor'
          )
        );
    }

    function criacaoPedidoBalcaoValida(pedidoId) {
      return hasRole(['vendedor', 'vendedora'])
        && request.resource.data.id == pedidoId
        && request.resource.data.origem == 'balcao'
        && request.resource.data.status == 'Recebido'
        && request.resource.data.lancadoPor.uid == request.auth.uid
        && request.resource.data.aluno is string
        && request.resource.data.aluno.size() >= 3
        && request.resource.data.nomeVinculo is string
        && request.resource.data.nomeVinculo.size() >= 3
        && request.resource.data.matricula is string
        && (
          request.resource.data.matricula == ''
          || request.resource.data.matricula.matches('^[A-Za-z0-9._-]{4,20}$')
        )
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.itens.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.numero is int
        && request.resource.data.numero > 0
        && request.resource.data.numero <= 9999
        && formaPagamentoValida()
        && contaProfessorPedidoBalcaoValida();
    }

    function atualizacaoAvaliacaoPedido() {
      return isPedidoOwner()
        && resource.data.status == 'Entregue'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'avaliacao',
          'comentarioAvaliacao',
          'avaliadoEm',
          'avaliadoPor'
        ])
        && request.resource.data.avaliacao is number
        && request.resource.data.avaliacao >= 1
        && request.resource.data.avaliacao <= 5
        && request.resource.data.avaliadoPor == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow get: if isSelf(uid) || isStaff();
      allow list: if isStaff();
      allow create: if false;
      allow update: if (isSelf(uid) && atualizacaoPropriaSegura()) || hasRole(['admin', 'gerente']);
      allow delete: if hasRole(['admin', 'gerente']);
    }

    match /recuperacaoSenha/{matricula} {
      allow read, write: if false;
    }

    match /produtos/{produtoId} {
      allow read: if isSignedIn();
      allow create: if quantidadesProdutoValidas()
        && (hasRole(['admin', 'gerente', 'cozinha']) || criacaoProdutoVendedorValida());
      allow delete: if isStaff();
      allow update: if quantidadesProdutoValidas()
        && (atualizacaoProdutoAdminSemEstoque()
          || atualizacaoProdutoVendedorSemEstoque()
          || atualizacaoEstoqueBebidaVendedor()
          || decrementoEstoquePedidoBalcao()
          || atualizacaoProdutoCozinha()
          || decrementoEstoquePorPedido()
          || devolucaoEstoquePorPedido());
    }

    match /contadoresPedidos/{chaveDiaria} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ultimoNumero == 1
        && request.resource.data.chaveDiaria == chaveDiaria;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoNumero', 'chaveDiaria', 'atualizadoEm', 'codigosUsados'])
        && request.resource.data.ultimoNumero == resource.data.ultimoNumero + 1
        && request.resource.data.ultimoNumero <= 9999
        && request.resource.data.chaveDiaria == chaveDiaria;
      allow delete: if false;
    }

    match /pedidos/{pedidoId} {
      allow read: if isStaff() || isPedidoOwner() || isPedidoAvulsoDoNome();
      allow create: if usuarioPodeCriarPedidoApp()
        || criacaoPedidoBalcaoValida(pedidoId);
      allow update: if isStaff()
        || atualizacaoAvaliacaoPedido()
        || vinculoPedidoAvulsoValido()
        || (
          isPedidoOwner()
          && isNovoPedidoOwner()
          && resource.data.status == 'Recebido'
        );
      allow delete: if isStaff();
    }

    match /avaliacoes/{avaliacaoId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.alunoId == request.auth.uid
        && request.resource.data.nota is number
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 280
        && exists(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId))
        && get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/pedidos/$(request.resource.data.pedidoId)).data.status == 'Entregue';
      allow delete: if isStaff();
    }

    match /avisos/{avisoId} {
      allow read: if isSignedIn();
      allow create, delete: if podeGerenciarAvisos();
      allow update: if isAvisoAutor()
        || (isSignedIn() && atualizacaoFixarAviso())
        || (isSignedIn() && atualizacaoArquivarAviso())
        || (isSignedIn() && atualizacaoLimparHistoricoAviso())
        || (isSignedIn() && (atualizacaoLeituraAviso() || atualizacaoRespostaAviso()));
    }

    match /avisosAnexos/{anexoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.dados is string
        && request.resource.data.dados.size() < 980000
        && request.resource.data.nome is string
        && request.resource.data.tipo is string;
      allow update: if false;
      allow delete: if hasRole(['admin', 'gerente']);
    }

    match /atendimentos/{atendimentoId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.solicitanteId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.solicitanteId == request.auth.uid
        && request.resource.data.pedidoId is string
        && request.resource.data.mensagens is list;
      allow update: if isStaff()
        || (isSignedIn() && resource.data.solicitanteId == request.auth.uid);
      allow delete: if hasRole(['admin', 'gerente']);
    }

    match /producaoDiaria/{producaoId} {
      allow read: if isStaff() || leituraProducaoCardapio();
      allow create, delete: if isCozinhaOuAdmin();
      allow update: if isCozinhaOuAdmin() || atualizacaoAjusteProducaoVendedor() || consumoProducaoPorPedido() || devolucaoProducaoPorPedido();
    }

    match /pushSubscriptions/{uid} {
      allow read, write: if isSelf(uid);
      allow read: if isStaff();
    }

    match /configuracoes/{configId} {
      allow read: if isSignedIn();
      allow write: if hasRole(['admin', 'gerente']);
    }

    match /_debug/{doc} {
      allow read, write: if isStaff();
    }
  }
}
